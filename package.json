{
  "name": "otw-cms-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "reference": "node scripts/build-reference.ts",
    "dev": "cms generate && node scripts/build-reference.ts && next dev",
    "build": "cms generate && node scripts/build-reference.ts && next build",
    "start": "next start",
    "typecheck": "cms generate && node scripts/build-reference.ts && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@otw/admin-ui": "link:../nextjs-cms/packages/admin-ui",
    "@otw/next": "link:../nextjs-cms/packages/next",
    "@otw/plugin-lms": "link:../otw-plugin-lms",
    "@otw/plugin-performance": "link:../otw-plugin-performance",
    "@otw/sdk": "link:../nextjs-cms/packages/sdk",
    "drizzle-orm": "^0.45.4",
    "hast-util-to-string": "^3.0.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@otw/cli": "link:../nextjs-cms/packages/cli",
    "@otw/plugin-commerce": "link:../nextjs-cms/plugins/commerce",
    "@otw/plugin-commerce-stripe": "link:../nextjs-cms/plugins/commerce-stripe",
    "@otw/testing": "link:../nextjs-cms/packages/testing",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "The OTW CMS documentation site, built on OTW CMS."
}
